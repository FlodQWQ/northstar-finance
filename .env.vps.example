# Docker Hub image published by the CI workflow.
DOCKER_IMAGE=your-dockerhub-username/northstar-finance
IMAGE_TAG=latest

# Local bind port and container timezone.
HOST_PORT=5888
TZ=Asia/Shanghai
CONTAINER_SEED_DEMO_DATA=false

# Public URL and application-native account registration.
APP_BASE_URL=https://finance.example.com/
REGISTRATION_MODE=closed

# One-time owner bootstrap for a fresh production database, and required when
# upgrading a v1 single-user volume. Remove them after the first verified start.
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD=

# Background event scheduler.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_MS=30000
SCHEDULER_LEASE_MS=600000

# SMTP notifications. Leave blank until mail delivery is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Northstar Finance <notifications@example.com>"

# AI integration. Keep AI_PROVIDER=none until a provider is configured.
AI_PROVIDER=none
# Legacy v1 migration only. Create scoped per-account tokens after signing in.
AI_API_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Public market prices. Use `multi` to query keyless exchange/CoinGecko
# adapters; leave `manual` when outbound network access is intentionally off.
PRICE_PROVIDER=manual
PRICE_PROXY=
PRICE_TIMEOUT_MS=6000
PRICE_MAX_QUOTE_TIME_MS=15000
PRICE_CACHE_TTL_MS=15000
PRICE_SYMBOL_ALIASES_JSON={}
PRICE_COINGECKO_IDS_JSON={}

# Optional outbound proxy. For a proxy on the VPS host, use
# http://host.docker.internal:7890 rather than 127.0.0.1.
CONTAINER_HTTP_PROXY=
CONTAINER_HTTPS_PROXY=
CONTAINER_NO_PROXY=localhost,127.0.0.1
