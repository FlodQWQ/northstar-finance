{
  "name": "northstar-finance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors cyan,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5888",
    "build": "tsc --noEmit && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "start:ai-worker": "cross-env NODE_ENV=production tsx server/ai-worker.ts",
    "start:win": "npm run start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.147.0",
    "@opencode-ai/sdk": "1.18.15",
    "better-sqlite3": "^12.2.0",
    "croner": "^9.1.0",
    "cross-env": "^10.0.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.536.0",
    "nodemailer": "^9.0.5",
    "opencode-ai": "1.18.15",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0",
    "recharts": "^3.1.2",
    "tsx": "^4.20.3",
    "undici": "^7.13.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.1",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
