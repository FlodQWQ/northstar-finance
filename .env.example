NODE_ENV=development
PORT=5888
API_PORT=5889
HOST=127.0.0.1
VITE_BASE_PATH=/
TZ=Asia/Shanghai
DATABASE_PATH=./data/finance.sqlite
SEED_DEMO_DATA=true
APP_BASE_URL=http://127.0.0.1:5888
# open accepts approval-required registration requests; closed keeps login only.
REGISTRATION_MODE=open

# One-time owner bootstrap for a fresh database, and required for a v1 upgrade.
# Remove these values after the first owner login has been verified.
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD=

SCHEDULER_ENABLED=true
SCHEDULER_POLL_MS=30000
SCHEDULER_LEASE_MS=600000

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

AI_PROVIDER=disabled
# Legacy v1 migration only. New accounts create scoped API tokens through
# /api/account/api-tokens.
AI_API_TOKEN=
# The application talks only to this isolated worker. Generate a long random
# token for non-Compose/local worker usage.
AI_WORKER_URL=http://127.0.0.1:5890
AI_WORKER_TOKEN=
AI_REQUEST_TIMEOUT_MS=200000
AI_PROVIDER_TIMEOUT_MS=90000
AI_JOB_TIMEOUT_MS=190000
AI_CANARY_TIMEOUT_MS=45000
AI_MAX_CONCURRENCY=2
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
CODEX_MODEL=
CODEX_MODEL_REASONING_EFFORT=medium
# Use provider/model (for example openai/gpt-5.2), or set the two explicit
# fields below. OpenCode web search is forced to Exa inside the worker.
OPENCODE_MODEL=opencode/big-pickle
OPENCODE_PROVIDER_ID=
OPENCODE_MODEL_ID=
OPENCODE_ENABLE_EXA=1
OPENCODE_WEBSEARCH_PROVIDER=exa

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
NODE_USE_ENV_PROXY=1

# Public market prices. Keep manual for offline deployments; multi uses
# keyless Binance/OKX/Bitget/Bybit/Gate and CoinGecko fallback adapters.
PRICE_PROVIDER=manual
PRICE_PROXY=
PRICE_TIMEOUT_MS=6000
PRICE_MAX_QUOTE_TIME_MS=15000
PRICE_CACHE_TTL_MS=15000
PRICE_SYMBOL_ALIASES_JSON={}
PRICE_COINGECKO_IDS_JSON={}

# Docker Compose only. Container localhost is not the Windows host.
CONTAINER_HTTP_PROXY=
CONTAINER_HTTPS_PROXY=
CONTAINER_NO_PROXY=localhost,127.0.0.1
CONTAINER_SEED_DEMO_DATA=false
