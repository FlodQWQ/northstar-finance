NODE_ENV=development
PORT=5888
API_PORT=5889
HOST=127.0.0.1
TZ=Asia/Shanghai
DATABASE_PATH=./data/finance.sqlite
SEED_DEMO_DATA=true
APP_BASE_URL=http://127.0.0.1:5888
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD=

SCHEDULER_ENABLED=true
SCHEDULER_POLL_MS=30000
SCHEDULER_LEASE_MS=600000

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFICATION_EMAIL=

AI_PROVIDER=none
AI_API_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# Docker Compose only. Container localhost is not the Windows host.
CONTAINER_HTTP_PROXY=
CONTAINER_HTTPS_PROXY=
CONTAINER_NO_PROXY=localhost,127.0.0.1
CONTAINER_SEED_DEMO_DATA=false
